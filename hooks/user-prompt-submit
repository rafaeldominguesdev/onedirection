#!/usr/bin/env bash
# UserPromptSubmit hook do plugin onedirection.
# A cada mensagem, só em projeto com NORTE.md: lembrete curto + a seção "Foco agora".
# Sem NORTE.md: não injeta nada.

set -euo pipefail

case "$0" in
  */*) SCRIPT_DIR="$(cd "${0%/*}" && pwd)" ;;
  *) SCRIPT_DIR="$(pwd)" ;;
esac
# shellcheck source=lib.sh
. "${SCRIPT_DIR}/lib.sh"

od_read_stdin >/dev/null
od_resolve

if [ -z "$OD_NORTE" ]; then
  printf '{}\n'
  exit 0
fi

# Extrai a seção "## Foco agora" (até o próximo "## ").
foco=""
in_foco=0
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    "## Foco agora"*) in_foco=1; continue ;;
    "## "*) [ "$in_foco" = 1 ] && break ;;
  esac
  if [ "$in_foco" = 1 ] && [ -n "$line" ]; then
    foco="${foco}${line}
"
  fi
done < "$OD_NORTE"

msg="[onedirection] Este projeto tem NORTE.md. Ideia nova que serve à promessa: siga. Conflito com trecho do NORTE.md: onedirection:guarding-the-direction. Antes de dizer pronto: onedirection:verifying-before-done. Fato sobre o projeto só com fonte."
if [ -n "$foco" ]; then
  msg="${msg}
Foco agora (NORTE.md):
${foco%$'\n'}"
fi

od_emit UserPromptSubmit "$msg"
exit 0
