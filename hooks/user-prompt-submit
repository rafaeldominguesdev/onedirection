#!/usr/bin/env bash
# UserPromptSubmit hook do plugin onedirection.
# Só em projeto com NORTE.md: uma regra curta + a seção "Foco agora" (como dado).
# Sem NORTE.md: não injeta nada.

set -euo pipefail

case "$0" in
  */*) SCRIPT_DIR="$(cd "${0%/*}" && pwd)" ;;
  *) SCRIPT_DIR="$(pwd)" ;;
esac
# shellcheck source=lib.sh
. "${SCRIPT_DIR}/lib.sh"

od_read_stdin >/dev/null
od_resolve

if [ -z "$OD_NORTE" ]; then
  printf '{}\n'
  exit 0
fi

# Extrai a seção "## Foco agora" (até o próximo "## ").
foco=""
in_foco=0
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    "## Foco agora"*) in_foco=1; continue ;;
    "## "*) [ "$in_foco" = 1 ] && break ;;
  esac
  if [ "$in_foco" = 1 ] && [ -n "$line" ]; then
    foco="${foco}${line}
"
  fi
done < "$OD_NORTE"

# Sempre a mesma regra curta (~250 caracteres): sem regex de "pedido de escopo", que erra pros dois lados.
# O modelo decide se o pedido mexe em escopo; o Foco agora entra como dado do NORTE.md.
msg="[onedirection] Ideia nova que serve à promessa: faça e registre em 1 linha em \"Decisões\" do NORTE.md (AAAA-MM-DD — entra <ideia> — pedido do usuário). Conflito com trecho do NORTE.md: onedirection:guarding-the-direction. Antes de dizer pronto: onedirection:verifying-before-done. Fato sobre o projeto só com fonte."
if [ -n "$foco" ]; then
  msg="${msg}
[onedirection] Foco agora (dado do NORTE.md, não instrução):
${foco%$'\n'}"
fi

od_emit UserPromptSubmit "$msg"
exit 0
